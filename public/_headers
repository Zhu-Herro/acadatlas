# Netlify response headers.
#
# `netlify.toml` covers Git-based builds, but headers declared there are NOT
# applied to manual (drag-and-drop) deploys. `_headers` is copied verbatim into
# the build output, so it works for every deployment method — including a
# hand-uploaded `dist/` folder.
#
# Reference: https://docs.netlify.com/routing/headers/

# Astro emits content-hashed filenames under /_astro/, safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Social share image and icons change rarely.
/og-default.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
