---
/**
 * /resources — the consolidated source index.
 *
 * Only official bodies and publicly published documents are listed. This page
 * is the visible half of the platform's credibility model: every claim made
 * anywhere on the site resolves to something listed here.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { entrySlug, inLocale, sortEntries } from '@/lib/content';
import { listOfficialBodies } from '@/lib/sources';
import { localizePath, useTranslations, type Locale } from '@/i18n/utils';
import { breadcrumbSchema, buildSeo } from '@/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const bodies = listOfficialBodies();

const systems = sortEntries(inLocale(await getCollection('systems'), locale));
const exams = sortEntries(inLocale(await getCollection('exams'), locale));
const guides = sortEntries(inLocale(await getCollection('guides'), locale));

const internal = [
  ...systems.map((entry) => ({
    href: localizePath(`/systems/${entrySlug(entry)}`, locale),
    label: entry.data.title,
    meta: t('systems.title'),
  })),
  ...exams.map((entry) => ({
    href: localizePath(`/exams/${entrySlug(entry)}`, locale),
    label: entry.data.title,
    meta: t('exams.title'),
  })),
  ...guides.slice(0, 8).map((entry) => ({
    href: localizePath(`/guides/${entrySlug(entry)}`, locale),
    label: entry.data.title,
    meta: t('guides.title'),
  })),
];

const seo = buildSeo({
  title: t('resources.title'),
  description: t('resources.lede'),
  locale,
  path: '/resources',
  jsonLd: [
    breadcrumbSchema(
      [
        { name: t('common.home'), path: '/' },
        { name: t('resources.title'), path: '/resources' },
      ],
      locale,
    ),
  ],
});
---

<BaseLayout locale={locale} seo={seo}>
  <PageHeader
    locale={locale}
    number="05"
    eyebrow={t('resources.title')}
    title={[t('resources.title')]}
    lede={t('resources.lede')}
    crumbs={[
      { name: t('common.home'), path: '/' },
      { name: t('resources.title'), path: '/resources' },
    ]}
  />

  <!-- ── Official bodies ───────────────────────────────────────────── -->
  <section class="edge-rule" aria-labelledby="official-title">
    <div class="u-container u-section">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
        <h2 id="official-title" data-reveal="fade" class="eyebrow eyebrow-accent">
          {t('resources.officialBodies')}
        </h2>
        <p class="meta-mono text-mist">{String(bodies.length).padStart(2, '0')}</p>
      </div>

      <ul class="mt-12 grid gap-x-10 gap-y-0 sm:grid-cols-2 lg:grid-cols-3">
        {
          bodies.map((body, index) => (
            <li
              data-reveal="up"
              style={`--reveal-delay:${(index % 6) * 50}ms`}
              class="border-t border-rule"
            >
              <a
                href={body.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex h-full flex-col gap-2.5 py-5"
              >
                <span class="flex items-start justify-between gap-4">
                  <span class="text-caption leading-snug text-ink transition-colors duration-300 group-hover:text-accent">
                    {body.label}
                  </span>
                  <span
                    aria-hidden="true"
                    class="mt-0.5 shrink-0 font-mono text-micro text-mist transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
                  >
                    ↗
                  </span>
                </span>
                <span class="truncate font-mono text-micro text-mist">{body.href}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p
        data-reveal="fade"
        class="mt-12 max-w-3xl border-l border-accent pl-5 text-caption leading-relaxed text-graphite"
      >
        {t('resources.note')}
      </p>
    </div>
  </section>

  <!-- ── Internal content index ────────────────────────────────────── -->
  <section class="edge-rule" aria-labelledby="internal-title">
    <div class="u-container u-section">
      <h2 id="internal-title" data-reveal="fade" class="eyebrow">
        {t('resources.internal')}
      </h2>

      <ol class="mt-12 flex flex-col border-t border-rule" data-stagger>
        {
          internal.map((item, index) => (
            <li class="border-b border-rule">
              <a href={item.href} class="group grid grid-cols-[3rem_1fr_auto] items-baseline gap-x-6 py-5">
                <span class="font-mono text-micro text-mist tabnum">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="text-h4 text-ink transition-colors duration-300 group-hover:text-accent">
                  {item.label}
                </span>
                <span class="font-mono text-micro uppercase tracking-[0.14em] text-mist">
                  {item.meta}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
