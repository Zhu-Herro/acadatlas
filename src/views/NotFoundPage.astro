---
/**
 * 404 — same design language, no apologising copy, real wayfinding.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/site.config';
import { localizePath, useTranslations, type Locale } from '@/i18n/utils';
import { buildSeo } from '@/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const seo = buildSeo({
  title: t('404.title'),
  description: t('404.lede'),
  locale,
  path: '/404',
  noindex: true,
});

/** Mirrors the section model, so the wayfinding matches the navigation. */
const suggestions = [
  { href: '/systems', label: t('systems.title') },
  { href: '/exams', label: t('exams.title') },
  { href: '/admissions', label: t('admissions.title') },
  { href: '/admissions/mainland', label: t('china.title') },
  { href: '/admissions/requirements', label: t('requirements.title') },
  { href: '/guides', label: t('guides.title') },
  { href: '/resources', label: t('resources.title') },
];
---

<BaseLayout locale={locale} seo={seo}>
  <section class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="bg-coordinate pointer-events-none absolute inset-0 [mask-image:radial-gradient(100%_70%_at_30%_0%,black,transparent_75%)]"
    >
    </div>

    <div class="u-container relative pb-24 pt-16 lg:pb-32 lg:pt-24">
      <p data-reveal="fade" class="eyebrow eyebrow-accent">{t('404.label')}</p>

      <h1 data-stagger class="mt-8 max-w-4xl font-display text-display text-ink">
        <span class="block">{t('404.title')}</span>
      </h1>

      <p data-reveal="up" style="--reveal-delay:220ms" class="mt-8 max-w-xl text-lead text-charcoal">
        {t('404.lede')}
      </p>

      <div class="mt-20 grid gap-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-4">
          <h2 class="eyebrow">{t('404.suggestions')}</h2>
          <ol class="mt-6 flex flex-col border-t border-rule">
            {
              suggestions.map((item, index) => (
                <li class="border-b border-rule">
                  <a
                    href={localizePath(item.href, locale)}
                    class="group flex items-baseline gap-4 py-4"
                  >
                    <span class="font-mono text-micro text-mist tabnum">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="flex-1 text-h4 text-ink transition-colors duration-300 group-hover:text-accent">
                      {item.label}
                    </span>
                    <span
                      aria-hidden="true"
                      class="font-mono text-caption text-mist transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1 group-hover:text-accent"
                    >
                      →
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="lg:col-span-8 lg:pt-1">
          <p class="max-w-md font-display text-h2 text-ink">{site.tagline[locale]}</p>
          <button
            type="button"
            data-search-open
            class="mt-10 inline-flex items-center gap-4 border border-rule px-5 py-3.5 transition-colors duration-300 hover:border-ink"
          >
            <span class="font-mono text-micro uppercase tracking-[0.16em] text-graphite">
              {t('search.open')}
            </span>
            <span aria-hidden="true" class="font-mono text-micro text-mist">⌘K</span>
          </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
