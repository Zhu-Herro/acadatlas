---
/**
 * /exams — qualification & examination overview.
 *
 * Rendered from the `exams` collection, split by family so that
 * university admissions tests and language proficiency tests are never
 * presented as if they were interchangeable.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { entrySlug, inLocale, sortEntries } from '@/lib/content';
import { localizePath, useTranslations, type Locale } from '@/i18n/utils';
import { breadcrumbSchema, buildSeo } from '@/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const exams = sortEntries(inLocale(await getCollection('exams'), locale));

const families = [
  {
    id: 'standardised',
    label: t('exams.familyStandardised'),
    entries: exams.filter((entry) => entry.data.family === 'standardised'),
  },
  {
    id: 'language',
    label: t('exams.familyLanguage'),
    entries: exams.filter((entry) => entry.data.family === 'language'),
  },
].filter((family) => family.entries.length > 0);

const seo = buildSeo({
  title: t('exams.title'),
  description: t('exams.lede'),
  locale,
  path: '/exams',
  jsonLd: [
    breadcrumbSchema(
      [
        { name: t('common.home'), path: '/' },
        { name: t('exams.title'), path: '/exams' },
      ],
      locale,
    ),
  ],
});
---

<BaseLayout locale={locale} seo={seo}>
  <PageHeader
    locale={locale}
    number="02"
    eyebrow={t('exams.title')}
    title={[t('exams.title')]}
    lede={t('exams.lede')}
    crumbs={[
      { name: t('common.home'), path: '/' },
      { name: t('exams.title'), path: '/exams' },
    ]}
  />

  <section class="edge-rule">
    <div class="u-container py-12">
      <p
        data-reveal="fade"
        class="max-w-3xl border-l border-accent pl-5 text-caption leading-relaxed text-graphite"
      >
        {t('exams.note')}
      </p>
    </div>
  </section>

  {
    families.map((family, familyIndex) => (
      <section class="edge-rule" aria-labelledby={`family-${family.id}`}>
        <div class="u-container u-section">
          <h2 id={`family-${family.id}`} data-reveal="fade" class="eyebrow eyebrow-accent">
            {family.label}
          </h2>

          <ol class="mt-14 flex flex-col border-t border-rule" data-stagger>
            {family.entries.map((entry, index) => (
              <li class="border-b border-rule">
                <a
                  href={localizePath(`/exams/${entrySlug(entry)}`, locale)}
                  class="group grid grid-cols-1 gap-x-10 gap-y-4 py-8 lg:grid-cols-[3.5rem_minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-baseline"
                >
                  <span class="font-mono text-meta text-accent tabnum">
                    {String(index + 1 + familyIndex * 10).padStart(2, '0')}
                  </span>

                  <span class="flex flex-col gap-2">
                    <span class="font-display text-h2 leading-none text-ink transition-colors duration-300 group-hover:text-accent">
                      {entry.data.shortName}
                    </span>
                    <span class="font-mono text-micro uppercase tracking-[0.14em] text-mist">
                      {entry.data.fullName}
                    </span>
                  </span>

                  <span class="max-w-lg text-caption leading-relaxed text-charcoal">
                    {entry.data.summary}
                  </span>

                  <span
                    aria-hidden="true"
                    class="font-mono text-caption text-mist transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5 group-hover:text-accent"
                  >
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))
  }

  <section class="edge-rule" aria-label={t('common.related')}>
    <div class="u-container py-16">
      <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          [
            { href: '/systems', label: t('systems.title'), note: t('systems.lede') },
            { href: '/pathways', label: t('pathways.title'), note: t('pathways.lede') },
          ].map((item, index) => (
            <li
              data-reveal="up"
              style={`--reveal-delay:${index * 70}ms`}
              class="border-t border-rule pt-5"
            >
              <a href={localizePath(item.href, locale)} class="group block">
                <p class="text-h3 text-ink transition-colors duration-300 group-hover:text-accent">
                  {item.label}
                </p>
                <p class="mt-3 text-caption leading-relaxed text-graphite">{item.note}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
