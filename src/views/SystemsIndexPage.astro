---
/**
 * /systems — the education systems overview.
 *
 * Lists curriculum systems as editorial cards AND states the information
 * architecture explicitly, so a reader never confuses a curriculum with an
 * examination or a language test (brief, section 8).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SystemCard from '@/components/SystemCard.astro';
import { entrySlug, inLocale, sortEntries } from '@/lib/content';
import { localizePath, useTranslations, type Locale } from '@/i18n/utils';
import { breadcrumbSchema, buildSeo } from '@/lib/seo';
import type { UIKey } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const systems = sortEntries(inLocale(await getCollection('systems'), locale));
const exams = sortEntries(inLocale(await getCollection('exams'), locale));

const taxonomy: { labelKey: UIKey; noteKey: UIKey; href: string; count: number }[] = [
  {
    labelKey: 'systems.group.curriculum',
    noteKey: 'systems.group.curriculum.note',
    href: '/systems',
    count: systems.length,
  },
  {
    labelKey: 'systems.group.exam',
    noteKey: 'systems.group.exam.note',
    href: '/exams',
    count: exams.length,
  },
  {
    labelKey: 'systems.group.language',
    noteKey: 'systems.group.language.note',
    href: '/exams',
    count: exams.length,
  },
  {
    labelKey: 'systems.group.admission',
    noteKey: 'systems.group.admission.note',
    href: '/pathways',
    count: 0,
  },
];

const seo = buildSeo({
  title: t('systems.title'),
  description: t('systems.lede'),
  locale,
  path: '/systems',
  jsonLd: [
    breadcrumbSchema(
      [
        { name: t('common.home'), path: '/' },
        { name: t('systems.title'), path: '/systems' },
      ],
      locale,
    ),
  ],
});
---

<BaseLayout locale={locale} seo={seo}>
  <PageHeader
    locale={locale}
    number="01"
    eyebrow={t('systems.title')}
    title={[t('systems.title')]}
    lede={t('systems.lede')}
    crumbs={[
      { name: t('common.home'), path: '/' },
      { name: t('systems.title'), path: '/systems' },
    ]}
  />

  <!-- ── Information architecture ──────────────────────────────────── -->
  <section class="edge-rule" aria-labelledby="taxonomy-title">
    <div class="u-container py-14">
      <h2 id="taxonomy-title" class="eyebrow">{t('systems.grouping')}</h2>

      <ul class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          taxonomy.map((item, index) => (
            <li
              data-reveal="up"
              style={`--reveal-delay:${index * 70}ms`}
              class="border-t border-rule pt-5"
            >
              <div class="flex items-baseline justify-between gap-4">
                <p class="text-h4 text-ink">{t(item.labelKey)}</p>
                {item.count > 0 && (
                  <span class="font-mono text-micro text-accent tabnum">
                    {String(item.count).padStart(2, '0')}
                  </span>
                )}
              </div>
              <p class="mt-2.5 text-caption leading-relaxed text-graphite">{t(item.noteKey)}</p>
              <a
                href={localizePath(item.href, locale)}
                class="link-underline mt-4 inline-block font-mono text-micro uppercase tracking-[0.14em]"
              >
                {t('common.viewAll')}
              </a>
            </li>
          ))
        }
      </ul>

      <p
        data-reveal="fade"
        class="mt-12 max-w-3xl border-l border-accent pl-5 text-caption leading-relaxed text-graphite"
      >
        {t('systems.note')}
      </p>
    </div>
  </section>

  <!-- ── Curriculum systems ────────────────────────────────────────── -->
  <section class="edge-rule" aria-labelledby="curriculum-title">
    <div class="u-container u-section">
      <h2 id="curriculum-title" class="eyebrow">{t('systems.group.curriculum')}</h2>

      <div class="mt-14 grid gap-x-12 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
        {
          systems.map((entry, index) => (
            <SystemCard
              name={entry.data.title}
              shortName={entry.data.shortName}
              fullName={entry.data.fullName}
              summary={entry.data.summary}
              region={entry.data.region}
              type={entry.data.type}
              href={localizePath(`/systems/${entrySlug(entry)}`, locale)}
              locale={locale}
              index={index}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Where to go next ─────────────────────────────────────────── -->
  <section class="edge-rule" aria-label={t('common.related')}>
    <div class="u-container py-16">
      <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-3">
        {
          [
            { href: '/exams', label: t('exams.title'), note: t('exams.lede') },
            { href: '/pathways', label: t('pathways.title'), note: t('pathways.lede') },
            { href: '/compare', label: t('compare.title'), note: t('compare.lede') },
          ].map((item, index) => (
            <li
              data-reveal="up"
              style={`--reveal-delay:${index * 70}ms`}
              class="border-t border-rule pt-5"
            >
              <a href={localizePath(item.href, locale)} class="group block">
                <p class="text-h3 text-ink transition-colors duration-300 group-hover:text-accent">
                  {item.label}
                </p>
                <p class="mt-3 text-caption leading-relaxed text-graphite">{item.note}</p>
                <span
                  aria-hidden="true"
                  class="mt-5 block font-mono text-caption text-mist transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5 group-hover:text-accent"
                >
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
