---
/**
 * /contact.
 *
 * Phase one is a static site with no backend, so the form is presented as a
 * non-submitting template with an explicit note and a working direct email —
 * rather than a form that silently drops messages.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/site.config';
import { localizePath, useTranslations, type Locale } from '@/i18n/utils';
import { breadcrumbSchema, buildSeo } from '@/lib/seo';
import type { UIKey } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const topics: { value: string; key: UIKey }[] = [
  { value: 'content', key: 'contact.form.topic.content' },
  { value: 'partnership', key: 'contact.form.topic.partnership' },
  { value: 'feedback', key: 'contact.form.topic.feedback' },
  { value: 'other', key: 'contact.form.topic.other' },
];

const seo = buildSeo({
  title: t('contact.title'),
  description: t('contact.lede'),
  locale,
  path: '/contact',
  jsonLd: [
    breadcrumbSchema(
      [
        { name: t('common.home'), path: '/' },
        { name: t('contact.title'), path: '/contact' },
      ],
      locale,
    ),
  ],
});
---

<BaseLayout locale={locale} seo={seo}>
  <PageHeader
    locale={locale}
    eyebrow={t('contact.title')}
    title={[t('contact.title')]}
    lede={t('contact.lede')}
    crumbs={[
      { name: t('common.home'), path: '/' },
      { name: t('contact.title'), path: '/contact' },
    ]}
  />

  <section class="edge-rule">
    <div class="u-container u-section">
      <div class="grid gap-16 lg:grid-cols-12 lg:gap-x-16">
        <!-- ── Direct contact ─────────────────────────────────────── -->
        <div class="lg:col-span-4">
          <h2 data-reveal="fade" class="eyebrow eyebrow-accent">{t('contact.direct')}</h2>

          <dl data-reveal="up" class="mt-8 flex flex-col border-t border-rule">
            <div class="flex flex-col gap-2 border-b border-rule py-5">
              <dt class="font-mono text-micro uppercase tracking-[0.14em] text-mist">Email</dt>
              <dd>
                <a
                  href={`mailto:${site.contact.email}`}
                  class="link-underline font-mono text-caption"
                >
                  {site.contact.email}
                </a>
              </dd>
            </div>
            <div class="flex flex-col gap-2 border-b border-rule py-5">
              <dt class="font-mono text-micro uppercase tracking-[0.14em] text-mist">WeChat</dt>
              <dd class="meta-mono text-charcoal">{site.contact.wechat}</dd>
            </div>
          </dl>

          <p class="mt-6 text-caption leading-relaxed text-graphite">
            {t('contact.responseTime')}
          </p>

          <p class="mt-8 border-l border-accent pl-5 text-caption leading-relaxed text-graphite">
            {site.editorialNote[locale]}
          </p>
        </div>

        <!-- ── Form scaffold ──────────────────────────────────────── -->
        <div class="lg:col-span-8">
          <h2 data-reveal="fade" class="eyebrow">{t('contact.form.title')}</h2>

          <p
            data-reveal="fade"
            class="mt-6 max-w-2xl border border-rule bg-paper-raised px-5 py-4 text-caption leading-relaxed text-graphite"
          >
            {t('contact.form.note')}
          </p>

          <!--
            NOTE FOR THE NEXT PHASE:
            This form is intentionally inert. Wire `action` to a Netlify Form
            handler (`data-netlify="true"`), a serverless function, or a
            third-party endpoint. All field names already match the future API
            payload, so no markup needs to change.
          -->
          <form class="mt-8 flex flex-col gap-7" novalidate>
            <div class="grid gap-7 sm:grid-cols-2">
              <div class="flex flex-col gap-2.5">
                <label for="contact-name" class="font-mono text-micro uppercase tracking-[0.14em] text-graphite">
                  {t('contact.form.name')}
                </label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder={t('contact.form.placeholder.name')}
                  class="border-b border-rule bg-transparent py-3 text-body text-ink outline-none transition-colors duration-300 placeholder:text-caption placeholder:text-mist focus:border-accent"
                />
              </div>

              <div class="flex flex-col gap-2.5">
                <label for="contact-email" class="font-mono text-micro uppercase tracking-[0.14em] text-graphite">
                  {t('contact.form.email')}
                </label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={t('contact.form.placeholder.email')}
                  class="border-b border-rule bg-transparent py-3 text-body text-ink outline-none transition-colors duration-300 placeholder:text-caption placeholder:text-mist focus:border-accent"
                />
              </div>
            </div>

            <div class="flex flex-col gap-2.5">
              <label for="contact-topic" class="font-mono text-micro uppercase tracking-[0.14em] text-graphite">
                {t('contact.form.topic')}
              </label>
              <select
                id="contact-topic"
                name="topic"
                class="border-b border-rule bg-transparent py-3 text-body text-ink outline-none transition-colors duration-300 focus:border-accent"
              >
                {topics.map((topic) => <option value={topic.value}>{t(topic.key)}</option>)}
              </select>
            </div>

            <div class="flex flex-col gap-2.5">
              <label for="contact-message" class="font-mono text-micro uppercase tracking-[0.14em] text-graphite">
                {t('contact.form.message')}
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                placeholder={t('contact.form.placeholder.message')}
                class="resize-y border-b border-rule bg-transparent py-3 text-body text-ink outline-none transition-colors duration-300 placeholder:text-caption placeholder:text-mist focus:border-accent"
              ></textarea>
            </div>

            <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
              <button
                type="submit"
                disabled
                class="font-mono text-meta uppercase tracking-[0.18em] text-mist"
                aria-describedby="contact-form-disabled-note"
              >
                {t('contact.form.submit')}
              </button>
              <span id="contact-form-disabled-note" class="font-mono text-micro text-mist">
                {t('common.comingSoon')}
              </span>
            </div>
          </form>

          <p class="mt-10">
            <a
              href={localizePath('/about', locale)}
              class="link-underline font-mono text-micro uppercase tracking-[0.16em]"
            >
              {t('about.title')} →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
