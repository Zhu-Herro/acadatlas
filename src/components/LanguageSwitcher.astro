---
/**
 * Language switcher.
 * Renders the equivalent of the CURRENT path in every locale, so switching
 * language never drops the reader back on the home page.
 */
import { languages, locales, type Locale } from '@/i18n/ui';
import { switchLocalePath, useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
---

<div class="flex items-center gap-1.5" role="group" aria-label={t('nav.languageSwitcher')}>
  {
    locales.map((target, index) => (
      <>
        {index > 0 && (
          <span aria-hidden="true" class="text-mist select-none">
            /
          </span>
        )}
        <a
          href={switchLocalePath(pathname, target)}
          hreflang={target}
          aria-current={target === locale ? 'true' : undefined}
          class:list={[
            'font-mono text-[0.6875rem] uppercase leading-none tracking-[0.14em] transition-colors duration-300 py-1',
            target === locale ? 'text-ink' : 'text-graphite hover:text-accent',
          ]}
        >
          {languages[target]}
        </a>
      </>
    ))
  }
</div>
