---
/**
 * Section number — the numeric spine of the site (01 / 02 / 03).
 * Rendered in mono with tabular figures so multi-digit numbers never shift.
 */
interface Props {
  value: string;
  /** Show a leading "01 /" divider. */
  divider?: boolean;
  accent?: boolean;
  class?: string;
}

const { value, divider = true, accent = true, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-baseline gap-2 font-mono text-micro uppercase tabnum', className]}>
  <span class:list={[accent ? 'text-accent' : 'text-graphite']}>{value}</span>
  {divider && <span aria-hidden="true" class="text-rule">/</span>}
</span>
