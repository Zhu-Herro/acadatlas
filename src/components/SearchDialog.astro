---
/**
 * Global search dialog (⌘K / Ctrl-K).
 *
 * Phase one is a client-side search over a pre-built static index
 * (`/search.json`). The index shape is intentionally the same one a hosted
 * engine (Pagefind, Algolia, Meilisearch) would need, so swapping the backend
 * later is a one-file change — see `src/pages/search.json.ts`.
 *
 * Accessibility: modal dialog semantics, focus trap, focus restore, Esc to
 * close, arrow-key navigation and a live region announcing result counts.
 */
import { useTranslations, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const suggestions = ['DSE', 'IB', 'A-Level', 'AP', 'IGCSE', 'Pathways'];
---

<div
  id="search-dialog"
  data-search-dialog
  hidden
  class="fixed inset-0 z-[60]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-dialog-title"
>
  <!-- Backdrop -->
  <div data-search-backdrop class="absolute inset-0 bg-ink/25 backdrop-blur-[3px]"></div>

  <!-- Panel -->
  <div
    class="relative mx-auto mt-[8vh] w-[min(46rem,calc(100%-2rem))] bg-paper-raised shadow-[0_28px_80px_-32px_rgba(14,16,14,0.35)]"
  >
    <h2 id="search-dialog-title" class="sr-only">{t('search.title')}</h2>

    <!-- Input row -->
    <div class="flex items-center gap-4 border-b border-rule px-5 py-4">
      <svg class="h-4 w-4 shrink-0 text-mist" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="6.8" cy="6.8" r="4.9" stroke="currentColor" stroke-width="1.3" />
        <path d="M10.6 10.6 14.4 14.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      </svg>
      <input
        data-search-input
        type="search"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        autocomplete="off"
        placeholder={t('search.placeholder')}
        class="w-full bg-transparent font-display text-h3 text-ink outline-none placeholder:font-sans placeholder:text-caption placeholder:tracking-normal placeholder:text-mist"
      />
      <button
        type="button"
        data-search-close
        class="shrink-0 border border-rule px-2 py-1 font-mono text-[0.625rem] uppercase leading-none tracking-[0.14em] text-graphite transition-colors duration-300 hover:border-ink hover:text-ink"
      >
        Esc
      </button>
    </div>

    <!-- Results -->
    <div class="max-h-[52vh] overflow-y-auto overscroll-contain">
      <ul id="search-results" data-search-results role="listbox" class="py-2"></ul>

      <!-- Initial state: suggestions -->
      <div data-search-empty class="px-5 py-10">
        <p class="eyebrow">{t('search.suggestions')}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            suggestions.map((suggestion) => (
              <button
                type="button"
                data-search-suggestion={suggestion}
                class="border border-rule px-3 py-1.5 font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-graphite transition-colors duration-300 hover:border-accent hover:text-accent"
              >
                {suggestion}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Keyboard hints -->
    <div
      class="flex items-center justify-between gap-4 border-t border-rule px-5 py-3"
    >
      <p class="meta-mono text-mist">{t('search.hint')}</p>
      <p data-search-count class="meta-mono text-mist" aria-hidden="true"></p>
    </div>

    <p class="sr-only" role="status" data-search-status></p>
  </div>
</div>

<script>
  /**
   * Search controller. Kept framework-free: the whole interaction is ~150 lines
   * of vanilla JS and adds no runtime dependency.
   */
  interface SearchRecord {
    title: string;
    description: string;
    href: string;
    kind: 'system' | 'exam' | 'guide' | 'page';
    lang: string;
    keywords: string[];
  }

  const dialog = document.querySelector<HTMLElement>('[data-search-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const resultsList = dialog?.querySelector<HTMLUListElement>('[data-search-results]');
  const emptyState = dialog?.querySelector<HTMLElement>('[data-search-empty]');
  const countLabel = dialog?.querySelector<HTMLElement>('[data-search-count]');
  const statusRegion = dialog?.querySelector<HTMLElement>('[data-search-status]');
  const locale = document.documentElement.lang?.startsWith('zh') ? 'zh' : 'en';

  /** Localised kind labels, mirrored from the UI dictionary. */
  const KIND_LABEL: Record<string, string> = {
    system: locale === 'zh' ? '教育体系' : 'System',
    exam: locale === 'zh' ? '考试' : 'Exam',
    guide: locale === 'zh' ? '指南' : 'Guide',
    page: locale === 'zh' ? '页面' : 'Page',
  };

  const COPY = {
    empty:
      locale === 'zh'
        ? '没有找到匹配内容。试试「DSE」「IB」「升学路径」等关键词。'
        : 'No matching content. Try "DSE", "IB" or "pathways".',
    count: (n: number) => (locale === 'zh' ? `找到 ${n} 条结果` : `${n} results`),
  };

  let records: SearchRecord[] | null = null;
  let filtered: SearchRecord[] = [];
  let cursor = -1;
  let lastFocused: HTMLElement | null = null;

  /** Lazily load the static index on first open. */
  async function loadIndex(): Promise<SearchRecord[]> {
    if (records) return records;
    try {
      const response = await fetch('/search.json');
      if (!response.ok) throw new Error(String(response.status));
      const payload = (await response.json()) as SearchRecord[];
      // Prefer the active locale, but never hide content that only exists in
      // the default language.
      records = payload;
    } catch {
      records = [];
    }
    return records;
  }

  /** Very small scoring function: exact > prefix > word-start > substring. */
  function score(record: SearchRecord, query: string): number {
    const haystackTitle = record.title.toLowerCase();
    const haystackKeywords = record.keywords.join(' ').toLowerCase();
    const haystackDescription = record.description.toLowerCase();

    if (haystackTitle === query) return 100;
    if (haystackTitle.startsWith(query)) return 80;
    if (haystackKeywords.split(/\s+/).some((word) => word.startsWith(query))) return 60;
    if (haystackTitle.includes(query)) return 50;
    if (haystackKeywords.includes(query)) return 35;
    if (haystackDescription.includes(query)) return 20;
    return 0;
  }

  function render() {
    if (!resultsList || !emptyState || !countLabel || !statusRegion) return;

    resultsList.innerHTML = '';
    const hasQuery = (input?.value ?? '').trim().length > 0;
    emptyState.hidden = filtered.length > 0 || !hasQuery;
    countLabel.textContent = hasQuery ? COPY.count(filtered.length) : '';

    if (hasQuery && filtered.length === 0) {
      emptyState.hidden = false;
      const message = emptyState.querySelector('p:last-child') ?? emptyState;
      void message;
    }

    filtered.forEach((record, index) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(index === cursor));

      const link = document.createElement('a');
      link.href = record.href;
      link.className =
        'group flex items-baseline gap-4 px-5 py-3.5 transition-colors duration-200 ' +
        (index === cursor ? 'bg-sand' : 'hover:bg-sand/60');

      link.innerHTML =
        `<span class="font-mono text-[0.625rem] uppercase tracking-[0.14em] text-mist w-20 shrink-0">${KIND_LABEL[record.kind] ?? ''}</span>` +
        `<span class="min-w-0 flex-1">` +
        `<span class="block truncate text-body text-ink">${record.title}</span>` +
        `<span class="mt-0.5 block truncate text-caption text-graphite">${record.description}</span>` +
        `</span>`;

      li.append(link);
      resultsList.append(li);
    });

    statusRegion.textContent = hasQuery ? COPY.count(filtered.length) : '';
  }

  async function runQuery(rawQuery: string) {
    const query = rawQuery.trim().toLowerCase();
    const index = await loadIndex();

    if (!query) {
      filtered = [];
      cursor = -1;
      render();
      return;
    }

    // Entries in the active locale rank above default-locale fallbacks.
    const scored = index
      .map((record) => {
        const base = score(record, query);
        if (base === 0) return { record, value: 0 };
        return { record, value: base + (record.lang === locale ? 12 : 0) };
      })
      .filter((entry) => entry.value > 0)
      .sort((a, b) => b.value - a.value)
      .slice(0, 12)
      .map((entry) => entry.record);

    filtered = scored;
    cursor = scored.length > 0 ? 0 : -1;
    render();
  }

  function open() {
    if (!dialog) return;
    lastFocused = document.activeElement as HTMLElement | null;
    dialog.hidden = false;
    document.body.classList.add('is-locked');
    input?.setAttribute('aria-expanded', 'true');
    // Defer so the transition is not skipped on first paint.
    window.setTimeout(() => input?.focus(), 20);
  }

  function close() {
    if (!dialog) return;
    dialog.hidden = true;
    document.body.classList.remove('is-locked');
    input?.setAttribute('aria-expanded', 'false');
    if (input) input.value = '';
    filtered = [];
    cursor = -1;
    render();
    lastFocused?.focus();
  }

  /* --- Triggers ------------------------------------------------------------ */
  document.querySelectorAll('[data-search-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      open();
    });
  });

  dialog?.querySelector('[data-search-close]')?.addEventListener('click', close);
  dialog?.querySelector('[data-search-backdrop]')?.addEventListener('click', close);

  dialog?.querySelectorAll('[data-search-suggestion]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const value = chip.getAttribute('data-search-suggestion') ?? '';
      if (input) {
        input.value = value;
        void runQuery(value);
        input.focus();
      }
    });
  });

  input?.addEventListener('input', (event) => {
    void runQuery((event.target as HTMLInputElement).value);
  });

  /* --- Keyboard ------------------------------------------------------------ */
  document.addEventListener('keydown', (event) => {
    const isOpen = dialog ? !dialog.hidden : false;

    // Global shortcut.
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      isOpen ? close() : open();
      return;
    }

    if (!isOpen) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      close();
      return;
    }

    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (filtered.length === 0) return;
      cursor = event.key === 'ArrowDown'
        ? (cursor + 1) % filtered.length
        : (cursor - 1 + filtered.length) % filtered.length;
      render();
      resultsList?.children[cursor]?.scrollIntoView({ block: 'nearest' });
      return;
    }

    if (event.key === 'Enter' && cursor >= 0 && filtered[cursor]) {
      event.preventDefault();
      window.location.href = filtered[cursor].href;
    }
  });

  // Focus trap: keep Tab inside the dialog while it is open.
  dialog?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const focusables = dialog.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])',
    );
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
