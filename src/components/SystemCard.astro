---
/**
 * SystemCard — a system entry inside a listing.
 *
 * "Card" here means a self-contained editorial unit with a hairline top rule,
 * not a rounded shadowed box. Large short-name, a one-line summary, the key
 * facts and a single quiet affordance.
 */
import { useTranslations, type Locale } from '@/i18n/utils';

interface Props {
  name: string;
  shortName: string;
  fullName: string;
  summary: string;
  href: string;
  region: string;
  type: string;
  locale: Locale;
  /** Sequential index used for the numeral. */
  index?: number;
  class?: string;
}

const {
  name,
  shortName,
  fullName,
  summary,
  href,
  region,
  type,
  locale,
  index,
  class: className = '',
} = Astro.props;

const t = useTranslations(locale);
---

<article
  data-reveal="up"
  class:list={['group relative flex flex-col border-t border-rule pt-7', className]}
>
  {
    typeof index === 'number' && (
      <span class="font-mono text-meta text-accent tabnum">
        {String(index + 1).padStart(2, '0')}
      </span>
    )
  }

  <h3 class="mt-5 font-display text-h2 leading-none text-ink">
    <a
      href={href}
      aria-label={`${name} — ${fullName}`}
      class="transition-colors duration-300 hover:text-accent"
    >
      <span aria-hidden="true">{shortName}</span>
    </a>
  </h3>

  <p class="mt-4 text-body text-charcoal">{summary}</p>

  <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-t border-rule pt-5">
    <div class="flex flex-col gap-1">
      <dt class="font-mono text-micro uppercase tracking-[0.14em] text-mist">{t('systems.region')}</dt>
      <dd class="meta-mono text-charcoal">{region}</dd>
    </div>
    <div class="flex flex-col gap-1">
      <dt class="font-mono text-micro uppercase tracking-[0.14em] text-mist">{t('systems.type')}</dt>
      <dd class="meta-mono text-charcoal">{type}</dd>
    </div>
  </dl>

  <a
    href={href}
    class="mt-7 inline-flex items-center gap-3 self-start font-mono text-micro uppercase tracking-[0.16em] text-accent"
  >
    <span class="link-underline">{t('systems.exploreSystem')}</span>
    <span
      aria-hidden="true"
      class="transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1"
    >
      →
    </span>
  </a>
</article>
