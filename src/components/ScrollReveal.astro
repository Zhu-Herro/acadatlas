---
/**
 * ScrollReveal — declarative wrapper around the global motion observer.
 * Keeps pages free of inline `data-*` bookkeeping.
 */
interface Props {
  /** up = fade + rise · fade = opacity · mask = clip wipe · rule = hairline draw */
  variant?: 'up' | 'fade' | 'mask' | 'rule';
  /** Stagger direct children instead of the wrapper itself. */
  stagger?: boolean;
  /** Delay in ms. */
  delay?: number;
  as?: 'div' | 'section' | 'article' | 'li' | 'figure' | 'header';
  class?: string;
}

const {
  variant = 'up',
  stagger = false,
  delay = 0,
  as: Tag = 'div',
  class: className = '',
} = Astro.props;

const attributes = stagger
  ? { 'data-stagger': '' }
  : { 'data-reveal': variant };

const style = delay ? `--reveal-delay:${delay}ms` : undefined;
---

<Tag class={className} style={style} {...attributes}>
  <slot />
</Tag>
