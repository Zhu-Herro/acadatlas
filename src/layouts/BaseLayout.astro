---
/**
 * Base layout — the single entry point for every rendered page.
 *
 * Responsibilities:
 *   • <head>: SEO metadata, fonts, JSON-LD, canonical + hreflang
 *   • chrome: skip link, header, footer, search dialog
 *   • global motion bootstrapping
 */
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import { site } from '@/site.config';
import { htmlLang, type Locale } from '@/i18n/utils';
import type { SeoOutput } from '@/lib/seo';

interface Props {
  locale: Locale;
  /**
   * Fully resolved metadata. Each page/view builds it once via `buildSeo()`
   * and hands the result here, so the layout stays a pure renderer and the
   * metadata logic lives in exactly one place (`src/lib/seo.ts`).
   */
  seo: SeoOutput;
  /** Applied to <body>; useful for page-specific theming. */
  bodyClass?: string;
}

const { locale, seo: meta, bodyClass = '' } = Astro.props;

/** Google Fonts, subset by the browser via unicode-range. */
const fontHref =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@100..900&family=Noto+Sans+SC:wght@100..900&display=swap';
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e100e" media="(prefers-color-scheme: dark)" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Hreflang alternates: every page declares its own translations. -->
    {
      meta.alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={meta.type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={meta.ogLocale} />
    {meta.publishedTime && (
      <meta property="article:published_time" content={meta.publishedTime.toISOString()} />
    )}
    {meta.modifiedTime && (
      <meta property="article:modified_time" content={meta.modifiedTime.toISOString()} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image} />

    <!-- Fonts: preconnect first so the CSS request is not on the critical path. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} media="print" data-font-stylesheet />
    <noscript>
      <link rel="stylesheet" href={fontHref} />
    </noscript>

    <!-- Structured data -->
    {
      meta.jsonLd.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }
  </head>

  <body class:list={['antialiased', bodyClass]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2.5 focus:text-caption focus:text-ink"
    >
      {locale === 'zh' ? '跳到主要内容' : 'Skip to main content'}
    </a>

    <Header locale={locale} />

    <main id="main" class="pt-24 sm:pt-28">
      <slot />
    </main>

    <Footer locale={locale} />
    <SearchDialog locale={locale} />

    <script>
      import { initMotion } from '@/scripts/motion';

      initMotion();

      /**
       * Fonts are requested with `media="print"` so the render path is never
       * blocked by a third-party stylesheet. Once the document has parsed we
       * switch the media query back to `all`, which applies the fonts at
       * normal priority. The stylesheet itself carries `display=swap`, so text
       * is readable from first paint either way.
       */
      const fontStylesheet = document.querySelector<HTMLLinkElement>('[data-font-stylesheet]');
      fontStylesheet?.setAttribute('media', 'all');
    </script>
  </body>
</html>
